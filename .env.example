# GEMINI_API_KEY: Server-side API key for Home Food Corner AI Menu Assistant
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Public URL where Home Food Corner PWA is hosted
APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION (Realtime for orders & notifications + Postgres persistence)
# Supports either VITE_ or NEXT_PUBLIC_ prefixes
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ADMIN & SECURITY
ADMIN_DEFAULT_EMAIL="admin@homefoodcorner.pk"
SESSION_SECRET="replace-with-strong-random-session-secret"
STORE_TIMEZONE="Asia/Karachi"

# WEB PUSH (VAPID) NOTIFICATIONS
# Leave blank to auto-generate persistent VAPID keys in data/store.json, or set explicitly for production:
VITE_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@homefoodcorner.pk"

# PAYMENT GATEWAY PLACEHOLDERS (Cash on Delivery + WhatsApp enabled by default)
STRIPE_SECRET_KEY=""
JAZZCASH_MERCHANT_ID=""
EASYPAISA_STORE_ID=""
